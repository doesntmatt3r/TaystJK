//------------------------------------------------------------------------------------------------
// Whisper menu
//------------------------------------------------------------------------------------------------

{
	menuDef 
	{
		name						"whisper"
		visible						1
		fullscreen					0
		outOfBoundsClick										// this closes the window if it gets a click out of the rectangle
		rect						180 80 280 300
		focusColor					1 1 1 1					// Focus color for text and items
		style						1
		border						1
		descX						320
		descY						360
		descScale					1
		descColor				.8 .596 .264 .75
		descAlignment					ITEM_ALIGN_CENTER		
		
//------------------------------------------------------------------------------------------------
// Overall window backdrop
//------------------------------------------------------------------------------------------------
		
		//bacground for player list (bigger)
		itemDef 
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 280 300
			background			"gfx/menus/menu_box_ingame"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		
//------------------------------------------------------------------------------------------------
// Inner box
//------------------------------------------------------------------------------------------------

		itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_EMPTY
			rect				5 5 265 270
			border				1
			bordercolor			.298 .305 .690 1
			bordersize			2
			forecolor			1 1 1 1
			visible				1
			decoration
		}

//------------------------------------------------------------------------------------------------
// Menu title box
//------------------------------------------------------------------------------------------------

		itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_FILLED
			rect				7 7 265 20
			backcolor			.298 .305 .690 1
			forecolor			.549 .854 1 1
			visible				1
			decoration
		}

//------------------------------------------------------------------------------------------------
// Menu title
//------------------------------------------------------------------------------------------------

		itemDef 
		{
			name				menuTitle
			style				0	
			text				"Whisper Menu"
			rect				5 2 270 20
			textalign			ITEM_ALIGN_CENTER
			textalignx			130
			textaligny			0
			outlinecolor			1 .5 .5 .5
			backcolor			0 0 0 0
//			font				4
//			textscale			1
			font				2
			textscale			1
			forecolor			.549 .854 1 1
			border				0
			bordercolor			0 0 0 0
			visible				1 
		}

//------------------------------------------------------------------------------------------------
// Player list
//------------------------------------------------------------------------------------------------
		
		itemDef 
		{
			name				playerList
			group				none
			descText			"Select a player"
			rect				13 35 250 215
			style				WINDOW_STYLE_FILLED
			type				ITEM_TYPE_LISTBOX
			elementwidth			120
			elementheight			20
			elementtype			LISTBOX_TEXT
			feeder				FEEDER_PLAYER_LIST
			border				1
			bordercolor			.8 .596 .264 .75
			backcolor			0 .28 .5 .25
			outlinecolor			.1 .1 .7 .5
			font				2
			textaligny			18
			textscale			.9
			forecolor			.627 0.706 0.937 1
			visible				1
			mouseEnter 
			{ 
				fadein message_arena ; 
				setitemcolor playerList bordercolor .5 .5 1 1
			} 
			mouseExit 
			{ 
				fadeout message_arena ; 
				setitemcolor playerList bordercolor .5 .5 .6 1 
			}
			action
			{
				play			"sound/interface/button1.wav" ; 
			}

		}
		
//------------------------------------------------------------------------------------------------
// Message button
//------------------------------------------------------------------------------------------------

		itemDef 
		{
			name				messageButton
			text				"Message"
			descText			"Write a message"
			type				1
			group				none
			style				WINDOW_STYLE_FILLED
			rect				100 250 80 30
			textalign			ITEM_ALIGN_CENTER
			textalignx			40
			textaligny			0
			font				3
			textscale			1
			forecolor			1 .745 .330 1
			visible				1
			action 
			{ 
				play			"sound/interface/button1.wav" ;
				uiScript 		whisper ; 
				uiScript 		closeingame 
			}
			mouseEnter 
			{ 
				show				doneButton
			}
			mouseExit 
			{ 
				hide				doneButton
			}	  	  
		}

	}
}